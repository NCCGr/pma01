{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pma01",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"preview_urls": true,
	// PMA_COOKIE_SECRET and PMA_SERVERS are set with `npx wrangler secret put`; see README.md.
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist",
		"not_found_handling": "404-page"
	},
	// Each phpMyAdmin session is one SQLite-backed Durable Object holding $_SESSION, like PHP's session file.
	"durable_objects": {
		"bindings": [
			{
				"name": "PMA_SESSIONS",
				"class_name": "PmaSessionObject"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["PmaSessionObject"]
		}
	]
}
